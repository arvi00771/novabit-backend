/**
 * NovaBit Exchange — Environment Variables (.env template)
 *
 * Copy this file to .env and fill in your values.
 */

# ── Server ──────────────────────────────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# ── PostgreSQL ──────────────────────────────────
DATABASE_URL=postgres://novabit:novabit_secret@localhost:5432/novabit_exchange

# ── Redis ───────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────
JWT_SECRET=change-this-to-a-long-random-string-in-production

# ── CORS ────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://062b1d0912863e846025d0fb0123f00c.ctonew.app,https://novabit.exchange

# ── Rate Limiting ───────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Logging ─────────────────────────────────────
LOG_LEVEL=info
# ── KYC document storage ───────────────────────
# REQUIRED in production. Must be an ABSOLUTE path to a PRIVATE, PERSISTENT,
# application-owned directory (identity documents are sensitive PII).
# The startup preflight enforces: absolute path, not inside /home/team/shared,
# owned by the process user, permissions 0700, writable.
# Recommended: a dedicated volume owned by the app user, e.g. /var/lib/novabit/kyc
KYC_DATA_DIR=/var/lib/novabit/kyc