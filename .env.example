/**
 * NovaBit Exchange — Environment Variables (.env template)
 *
 * Copy this file to .env and fill in your values.
 */

# ── Server ──────────────────────────────────────
# NODE_ENV=production enables the production deployment gates below.
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

# ── PostgreSQL ──────────────────────────────────
# REQUIRED in production (app refuses to boot without it). Empty/absent in
# dev/test selects the in-memory SQLite adapter — never production.
DATABASE_URL=postgres://novabit:novabit_secret@localhost:5432/novabit_exchange

# ── Redis ───────────────────────────────────────
# REQUIRED in production. Empty in dev/test = in-memory mock.
REDIS_URL=redis://localhost:6379

# ── JWT ─────────────────────────────────────────
# REQUIRED in production — must be a long random secret; the dev default must
# never reach production (issued tokens would be forgeable).
JWT_SECRET=change-this-to-a-long-random-string-in-production

# ── Wallet HD seed ──────────────────────────────
# REQUIRED in production — must be a high-entropy secret. Derives wallet
# addresses; the dev default must never be used in production.
WALLET_SEED=change-this-to-a-long-random-seed-in-production

# ── CORS ────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://062b1d0912863e846025d0fb0123f00c.ctonew.app,https://novabit.exchange

# ── Rate Limiting ───────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── Logging ─────────────────────────────────────
LOG_LEVEL=info

# ── KYC document storage ────────────────────────
# REQUIRED in production. Must be an ABSOLUTE path to a PRIVATE, PERSISTENT,
# application-owned directory (identity documents are sensitive PII).
# The startup preflight enforces: absolute path, not inside /home/team/shared,
# owned by the process user, permissions 0700, writable.
# Recommended: a dedicated volume owned by the app user, e.g. /var/lib/novabit/kyc
KYC_DATA_DIR=/var/lib/novabit/kyc